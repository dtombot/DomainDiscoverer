---
import BaseLayout from './BaseLayout.astro';
const p: any = Astro.props || {};
const fm: any = p.frontmatter || {};
const title: string = String(p.title ?? fm.title ?? 'Domain guide');
const description: string = String(p.description ?? fm.description ?? 'Practical domain education from Domain Discoverer.');
const pubDate = p.pubDate ?? fm.pubDate;
const updatedDate = p.updatedDate ?? fm.updatedDate ?? pubDate;
const category = p.category ?? fm.category ?? 'Domain research';
const site = 'https://domaindiscoverer.com';
const toISO = (value: unknown) => value ? new Date(String(value)).toISOString().slice(0,10) : undefined;
const schema = [
  { '@context':'https://schema.org', '@type':'BlogPosting', headline:title, description, datePublished:toISO(pubDate), dateModified:toISO(updatedDate), mainEntityOfPage:`${site}${Astro.url.pathname}`, publisher:{'@type':'Organization',name:'Domain Discoverer',url:site} },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem',position:1,name:'Home',item:`${site}/` },
    { '@type':'ListItem',position:2,name:'Guides',item:`${site}/blog` },
    { '@type':'ListItem',position:3,name:title,item:`${site}${Astro.url.pathname}` }
  ]}
];
---
<BaseLayout {title} {description} structuredData={schema}>
  <header class="article-header">
    <div class="container-pad">
      <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog">Guides</a><span>/</span><span aria-current="page">{category}</span></nav>
      <p class="eyebrow">{category}</p>
      <h1 class="display">{title.replace(/ \(2025\)/g, '')}</h1>
      <p class="article-deck">{description}</p>
      {pubDate && <p class="article-meta"><time datetime={toISO(pubDate)}>Published {new Date(pubDate).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>{updatedDate && toISO(updatedDate)!==toISO(pubDate) && <span> · Updated <time datetime={toISO(updatedDate)}>{new Date(updatedDate).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time></span>}</p>}
    </div>
  </header>
  <div class="container-pad article-quick"><div><strong>Have a domain name in mind?</strong><span>Check whether it is available before registering.</span></div><a href="/domain-availability-checker" class="body-link">Check availability →</a></div>
  <article class="container-pad article-body"><div class="prose"><slot /></div></article>
  <aside class="container-pad further-reading">
    <p class="section-kicker">Related guides</p>
    <h2 class="display">More to read</h2>
    <div class="rail-grid">
      <a class="rail-item" href="/blog/what-is-a-domain-name"><span class="rail-index">Domain basics</span><h3>What is a domain name? ↗</h3><p>Understand the address before you buy it.</p></a>
      <a class="rail-item" href="/blog/how-to-choose-a-domain-name"><span class="rail-index">Naming</span><h3>How to choose a domain name ↗</h3><p>A practical shortlist and evaluation method.</p></a>
      <a class="rail-item" href="/blog/domain-name-vs-web-hosting"><span class="rail-index">Website setup</span><h3>Domain vs web hosting ↗</h3><p>Know which service does what.</p></a>
    </div>
  </aside>
</BaseLayout>
<style>
  .article-header { padding: 4.5rem 0 3rem; border-bottom: 1px solid var(--line); }
  .article-header h1 { max-width: 900px; font-size: clamp(2.3rem, 5vw, 4.2rem); font-weight: 750; line-height: 1.2; margin: 1.25rem 0 1.7rem; }
  .article-deck { max-width: 700px; color: var(--muted); font-size: 1.2rem; }
  .article-meta { font-size: .77rem; color: var(--muted); margin-top: 1.5rem; }
  .article-quick { display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid var(--line); padding-block: 1.3rem; }
  .article-quick strong, .article-quick span { display: block; }
  .article-quick strong { font-size: .95rem; }
  .article-quick span { font-size: .83rem; color: var(--muted); }
  .article-body { padding-top: 3.3rem; }
  .further-reading { margin-top: 6rem; }
  .further-reading h2 { font-size: clamp(1.75rem, 3vw, 2.4rem); font-weight: 720; margin: 1rem 0 2rem; }
  @media(max-width:670px) { .article-quick { align-items: flex-start; flex-direction: column; } }
</style>
