---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Domain Research Tools: Availability, History, SEO & Sales';
const description = 'Explore useful domain name research tools for checking availability, researching domain history, finding expired domains, assessing SEO signals, and comparing sales.';
const groups = [
  { id: 'availability', number: '01', title: 'Availability & discovery', copy: 'Generate a shortlist and check exact names before moving deeper.', tools:[
    {name:'Instant Domain Search',href:'https://instantdomainsearch.com/',summary:'Rapid idea exploration and domain availability browsing.',note:'Confirm availability and pricing at registrar checkout.'},
    {name:'ExpiredDomains.net',href:'https://www.expireddomains.net/',summary:'Search expired, deleted and expiring domain lists with detailed filters.',note:'An expiring name is not necessarily available to register.'},
    {name:'NameMaxi',href:'https://namemaxi.com/',summary:'Explore names and patterns across available research features.',note:'Review the current free and paid features before committing.'}
  ]},
  { id: 'history', number: '02', title: 'History & technical checks', copy: 'Understand what a previously registered name has been connected to.', tools:[
    {name:'DomainIQ',href:'https://www.domainiq.com/',summary:'Historical domain, ownership and related infrastructure research.',note:'Access to some reports may be paid.'},
    {name:'DNSlytics',href:'https://dnslytics.com/',summary:'Reverse lookup and DNS-related technical research.',note:'Treat shared infrastructure as a clue, not proof of ownership.'},
    {name:'DotDB',href:'https://dotdb.com/',summary:'See domain registrations across extensions that contain a term.',note:'Similar names can signal popularity or trademark confusion.'}
  ]},
  { id: 'value', number: '03', title: 'Sales data & search signals', copy: 'Evaluate demand and background signals without mistaking estimates for facts.', tools:[
    {name:'NameBio',href:'https://namebio.com/',summary:'Search reported domain sales for comparable transactions.',note:'Past transactions do not guarantee future resale value.'},
    {name:'Ahrefs',href:'https://ahrefs.com/',summary:'Inspect backlink profiles and search-related signals.',note:'Third-party SEO metrics are estimates and require context.'},
    {name:'Semrush',href:'https://www.semrush.com/',summary:'Research keywords, search topics and competitive traffic estimates.',note:'Traffic and search-volume figures are estimates.'},
    {name:'EstiBot',href:'https://www.estibot.com/',summary:'Explore automated appraisal and related domain data.',note:'An automated valuation is not an actual market offer.'}
  ]}
];
---
<BaseLayout {title} {description}>
  <section class="tools-hero"><div class="container-pad">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Research tools</span></nav>
    <p class="eyebrow">Independent research directory</p>
    <h1>Tools for better domain decisions.</h1>
    <p>Find services for exploring names, understanding domain history and assessing market signals. Each tool has a specific purpose.</p>
    <div class="tool-jump" aria-label="Research categories">
      {groups.map(group => <a href={`#${group.id}`}>{group.title} <span aria-hidden="true">↘</span></a>)}
    </div>
  </div></section>
  <div class="tools-directory">
    {groups.map(group => <section class="container-pad tool-group" id={group.id}>
      <div class="tool-group-intro"><p class="section-kicker">{group.title}</p><h2>{group.copy}</h2></div>
      <div class="tool-rows">
        {group.tools.map(tool => <a href={tool.href} target="_blank" rel="noopener noreferrer" class="tool-row">
          <span class="tool-name">{tool.name}<span aria-hidden="true">↗</span></span>
          <span class="tool-description">{tool.summary}<small>{tool.note}</small></span>
        </a>)}
      </div>
    </section>)}
    <aside class="container-pad directory-note">
      <h2>Use the evidence. Not just the estimate.</h2>
      <p>Some tools require payment for detailed reports. Estimated search traffic and automated valuations do not guarantee future demand or resale value. We do not send your domain searches to these sites automatically. Some external links may be affiliate links; see our <a href="/disclosure">disclosure</a>.</p>
      <a class="button-accent" href="/domain-availability-checker">Check a domain ↗</a>
    </aside>
  </div>
</BaseLayout>
<style>
  .tools-hero { background: #182641; padding-block: 3.75rem 4.5rem; }
  .tools-hero h1 { max-width: 840px; font-size: clamp(3.1rem,6vw,5.7rem); font-weight: 565; line-height: 1.1; letter-spacing: -.06em; margin: 1.25rem 0 1.4rem; }
  .tools-hero > .container-pad > p:not(.eyebrow) { color: var(--muted); font-size: 1.05rem; max-width: 680px; }
  .tool-jump { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2.4rem; }
  .tool-jump a { border: 1px solid #607996; border-radius: 4px; padding: .52rem .75rem; color: #e0effc; font-size: .79rem; text-decoration: none; }
  .tool-jump a:hover { border-color: var(--accent); }
  .tool-jump span { margin-left: .4rem; color: var(--accent); }
  .tools-directory { background: var(--cream); color: var(--paper-ink); padding-bottom: 5rem; }
  .tool-group { scroll-margin-top: 5.5rem; display: grid; grid-template-columns: minmax(230px,.65fr) minmax(0,1.3fr); gap: clamp(2rem,7vw,8rem); padding-top: clamp(4rem,7vw,6rem); }
  .tool-group + .tool-group { margin-top: 3rem; padding-top: 4rem; border-top: 1px solid var(--paper-line); }
  .tool-group-intro .section-kicker { color: #347e8c; }
  .tool-group h2 { font-size: clamp(1.5rem,2.7vw,2.2rem); letter-spacing: -.035em; font-weight: 590; line-height: 1.35; margin-top: .9rem; }
  .tool-rows { border-top: 1px solid var(--paper-line); }
  .tool-row { display: grid; grid-template-columns: minmax(110px,.63fr) minmax(0,1fr); align-items: start; gap: 1.8rem; border-bottom: 1px solid var(--paper-line); padding: 1.35rem .15rem; text-decoration: none; transition: padding .16s ease; }
  .tool-row:hover { padding-left: .6rem; }
  .tool-name { display: flex; justify-content: space-between; gap: .5rem; color: #20354e; font-size: .94rem; font-weight: 675; }
  .tool-name span { color: #3a8d9c; }
  .tool-description { color: #5e7486; font-size: .86rem; line-height: 1.65; }
  .tool-description small { display: block; margin-top: .5rem; color: #668494; font-size: .78rem; }
  .directory-note { border-top: 1px solid var(--paper-line); padding-top: 3rem; margin-top: 5rem; }
  .directory-note h2 { font-size: clamp(1.75rem,3vw,2.3rem); font-weight: 610; letter-spacing: -.035em; }
  .directory-note p { max-width: 800px; color: #5b7487; font-size: .9rem; line-height: 1.75; margin: 1rem 0 1.5rem; }
  .directory-note a:not(.button-accent) { color: #207c8c; }
  @media(max-width:850px) { .tool-group { grid-template-columns: 1fr; gap: 1.4rem; } }
  @media(max-width:570px) { .tool-row { grid-template-columns: 1fr; gap: .35rem; } }
</style>
