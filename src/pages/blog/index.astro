---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Domain Name Guides: Basics, Registration & Research';
const description = 'Learn about domain names, choosing extensions, web hosting, availability checks, privacy, renewals, brandability and domain research tools.';
const posts = (await Astro.glob('./*.md'))
  .map((post) => ({
    url: post.url,
    title: String(post.frontmatter.title ?? 'Domain guide').replace(/ \(2025\)/g, ''),
    description: String(post.frontmatter.description ?? ''),
    pubDate: post.frontmatter.pubDate,
    category: post.frontmatter.category ?? 'Domain research'
  }))
  .sort((a,b) => +new Date(b.pubDate) - +new Date(a.pubDate));
---
<BaseLayout {title} {description}>
  <section class="page-hero"><div class="container-pad">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Guides</span></nav>
    <p class="eyebrow">Domain learning library</p>
    <h1 class="display">Domain name guides</h1>
    <p>Clear explanations of domain names, hosting, extensions, registration and the research involved in choosing a name.</p>
  </div></section>
  <section class="container-pad library-section">
    <div class="library-top"><h2>Browse the guides</h2><a href="/domain-availability-checker" class="body-link">Check a domain →</a></div>
    <div class="rail-grid">
      {posts.map((post) => (
        <a class="rail-item" href={post.url}>
          <span class="rail-index">{post.category}</span>
          <h3>{post.title} <span aria-hidden="true">↗</span></h3>
          <p>{post.description}</p>
        </a>
      ))}
    </div>
    <div class="library-note"><strong>Registering a name?</strong> Check availability, potential trademark conflicts, renewal prices and any requirements attached to its extension.</div>
  </section>
</BaseLayout>
<style>
  .library-section { padding-top: 3.5rem; }
  .library-top { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin-bottom: 1.5rem; }
  .library-top h2 { font-size: 1.45rem; font-weight: 700; letter-spacing: -.03em; }
  .library-note { margin: 3rem 0; padding: 1.35rem 0; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
  .library-note strong { color: var(--text); }
  @media(max-width:740px) { .library-top { align-items: flex-start; flex-direction: column; gap: .65rem; } }
</style>
