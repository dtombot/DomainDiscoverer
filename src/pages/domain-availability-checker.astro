---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainSearch from '../components/DomainSearch.astro';
const title = 'Free Domain Availability Checker | Search a Domain Name';
const description = 'Check if a domain name is available with a simple free lookup. Search a .com or other extension and learn what to do before registering.';
const breadcrumbs = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
  { '@type':'ListItem',position:1,name:'Home',item:'https://domaindiscoverer.com/' },
  { '@type':'ListItem',position:2,name:'Domain availability checker',item:'https://domaindiscoverer.com/domain-availability-checker' }
]};
---
<BaseLayout {title} {description} structuredData={breadcrumbs}>
  <section class="page-hero checker-hero">
    <div class="container-pad">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Domain checker</span></nav>
      <p class="eyebrow">Free availability lookup</p>
      <h1 class="display">Check domain availability</h1>
      <p>Type the name you want to check. We'll look it up, then you can confirm the result and pricing with a registrar.</p>
      <DomainSearch />
    </div>
  </section>
  <section class="container-pad checker-body">
    <div class="how-to-grid">
      <div><h2>Search the exact name</h2><p>Try example.com or another domain extension. Each extension counts as a separate name.</p></div>
      <div><h2>Confirm availability</h2><p>The result may change, and some names have restrictions or premium prices. Confirm before you pay.</p></div>
      <div><h2>Compare the full cost</h2><p>Check first-year and renewal prices, privacy options and transfer rules before registering.</p></div>
    </div>
    <section class="checker-faq">
      <p class="section-kicker">Frequently asked questions</p>
      <h2>About checking domains</h2>
      <details><summary>Is this domain availability check free?</summary><p>Yes. You do not need an account to submit a single name. Each submission makes one lookup request.</p></details>
      <details><summary>Can I buy the domain here?</summary><p>No. Domain Discoverer helps you check and research names. Registration is completed on a registrar's website.</p></details>
      <details><summary>Why might a result differ from a registrar's checkout?</summary><p>Availability can change quickly, and registry restrictions or premium classifications may apply. Treat the registrar's checkout as the final confirmation.</p></details>
      <details><summary>What if the name is taken?</summary><p>Try a short, clear variation or another extension. Avoid confusing spellings or a name too close to an existing brand.</p></details>
      <a href="/blog/how-to-check-domain-availability-smart-way" class="body-link">Read the domain availability guide →</a>
    </section>
  </section>
</BaseLayout>
<style>
  .checker-body { padding-top: 3.5rem; }
  .how-to-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2rem; padding-bottom: 3rem; border-bottom: 1px solid var(--line); }
  .how-to-grid h2 { font-size: 1.05rem; font-weight: 700; margin-bottom: .75rem; letter-spacing: -.02em; }
  .how-to-grid p { color: var(--muted); font-size: .91rem; line-height: 1.7; }
  .checker-faq { max-width: 800px; padding-top: 4rem; }
  .checker-faq h2 { font-size: clamp(1.8rem,3vw,2.4rem); letter-spacing: -.04em; font-weight: 730; margin: .5rem 0 1.5rem; }
  .checker-faq details { border-bottom: 1px solid var(--line); padding: 1.25rem 0; }
  .checker-faq summary { cursor: pointer; font-size: .97rem; font-weight: 650; }
  .checker-faq details p { margin-top: .7rem; color: var(--muted); max-width: 690px; line-height: 1.7; }
  .checker-faq .body-link { margin-top: 2rem; }
  .checker-hero :global(.domain-lookup) { margin-top: 2rem; }
  @media(max-width:740px) { .how-to-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
