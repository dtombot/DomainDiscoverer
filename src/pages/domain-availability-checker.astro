---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainSearch from '../components/DomainSearch.astro';
import HeroGeometry from '../components/HeroGeometry.astro';
const title = 'Free Domain Availability Checker | Search a Domain Name';
const description = 'Check whether a domain name is available. Search .com or other extensions with a free lookup, then verify final pricing with a registrar.';
const breadcrumbs = { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  { '@type':'ListItem',position:1,name:'Home',item:'https://domaindiscoverer.com/' },
  { '@type':'ListItem',position:2,name:'Domain availability checker',item:'https://domaindiscoverer.com/domain-availability-checker' }
]};
const faqs = [
  {q:'Is the domain availability check free?',a:'Yes. You do not need an account to submit a name. Each submission makes one live lookup request.'},
  {q:'Can I buy a domain here?',a:'No. Domain Discoverer provides availability research. Registration is completed on a registrar’s website.'},
  {q:'Why can availability change at checkout?',a:'Domain availability changes, and some names are reserved, restricted or classified as premium. The registrar’s checkout is the final confirmation.'},
  {q:'What should I do if my domain is already taken?',a:'Try a clear variation or another extension. Check for existing trademarks before deciding on a similar name.'},
  {q:'Can I check different extensions?',a:'Yes. Select an extension below the search field, then submit another check. We make no automatic background lookups.'}
];
---
<BaseLayout {title} {description} structuredData={breadcrumbs}>
  <section class="checker-hero">
    <HeroGeometry />
    <div class="container-pad checker-content">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Domain checker</span></nav>
      <p class="eyebrow">Domain availability checker</p>
      <h1>Check a domain name.</h1>
      <p class="checker-lead">Find out whether your chosen domain may be available. Try different extensions, then confirm the final price and registration terms with a registrar.</p>
      <DomainSearch heading="What domain would you like to check?" />
    </div>
  </section>
  <section class="checker-steps">
    <div class="container-pad">
      <div class="steps-heading"><p class="section-kicker">Before you register</p><h2>Three things worth checking.</h2></div>
      <div class="step-grid">
        <div><h3>Spell it clearly</h3><p>Choose a name that people can remember and type without explanation.</p></div>
        <div><h3>Check the extension</h3><p>Look at the extension’s purpose, eligibility requirements and common usage.</p></div>
        <div><h3>Compare renewals</h3><p>Review ongoing costs and privacy options, not just the first-year offer.</p></div>
      </div>
    </div>
  </section>
  <section class="container-pad checker-faq">
    <div class="faq-head"><p class="section-kicker">Common questions</p><h2>About domain availability</h2><p>What the lookup can tell you, and what still needs confirming.</p><a class="body-link" href="/blog/how-to-check-domain-availability-smart-way">Read the full availability guide ↗</a></div>
    <div class="faq-list">{faqs.map(({q,a}) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div>
  </section>
</BaseLayout>
<style>
  .checker-hero { position:relative; isolation:isolate; overflow:hidden; padding-block:clamp(3rem,6vw,5rem) clamp(3.7rem,7vw,6rem); background:#182641; border-bottom:1px solid var(--line); }
  .checker-content { position:relative; z-index:2; }
  .checker-hero :global(.domain-lookup) { max-width:900px; }

  .checker-hero h1 { font-size: clamp(3rem,6vw,5.4rem); font-weight: 570; letter-spacing: -.06em; line-height: 1.12; margin: 1.3rem 0 1.1rem; }
  .checker-lead { max-width: 740px; color: #c1d1e2; font-size: 1.09rem; line-height: 1.75; margin-bottom: 2.6rem; }
  .checker-steps { padding-block: 4.7rem; background: var(--cream); color: var(--paper-ink); }
  .steps-heading h2 { font-size: clamp(2.1rem,3.5vw,3rem); font-weight: 585; line-height: 1.2; letter-spacing: -.045em; margin: .9rem 0 2.5rem; }
  .checker-steps .section-kicker { color: #2c7182; }
  .step-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2.8rem; }
  .step-grid > div { padding-top: 1.4rem; border-top: 1px solid var(--paper-line); }
  .step-grid h3 { font-size: 1.1rem; font-weight: 645; letter-spacing: -.025em; }
  .step-grid p { max-width: 300px; margin-top: .6rem; color: #657b89; font-size: .91rem; line-height: 1.75; }
  .checker-faq { display: grid; grid-template-columns: minmax(240px,.7fr) minmax(0,1fr); gap: clamp(2rem,7vw,7rem); padding-top: 5.5rem; }
  .faq-head h2 { font-size: clamp(2rem,3.5vw,3rem); font-weight: 580; line-height: 1.17; letter-spacing: -.05em; margin: 1rem 0; }
  .faq-head p:not(.section-kicker) { color: var(--muted); font-size: .9rem; margin-bottom: 1.4rem; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; list-style: none; padding: 1.4rem 0; font-weight: 600; font-size: .96rem; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { color: var(--accent); font-size: 1.2rem; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list details p { padding: 0 1.5rem 1.5rem 0; color: var(--muted); font-size: .91rem; line-height: 1.75; }
  @media(max-width:750px) { .step-grid,.checker-faq { grid-template-columns: 1fr; } .step-grid { gap: 1.2rem; } .checker-faq { padding-top: 4rem; } }
</style>
