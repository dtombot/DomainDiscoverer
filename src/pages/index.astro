---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainSearch from '../components/DomainSearch.astro';
const title = 'Free Domain Availability Checker & Domain Name Guides | Domain Discoverer';
const description = 'Check domain name availability for free and browse reliable guides to choosing domains, extensions, registration and research.';
const guides = [
  { title:'How to choose a domain name', summary:'A straightforward checklist for picking a name that people can remember.', href:'/blog/how-to-choose-a-domain-name' },
  { title:'What is a domain name?', summary:'How website addresses, registrars and domain ownership work.', href:'/blog/what-is-a-domain-name' },
  { title:'Domain extensions explained', summary:'Understand .com and other extensions before you register.', href:'/blog/domain-extensions-guide' }
];
---
<BaseLayout {title} {description}>
  <section class="home-hero" id="check">
    <div class="container-pad hero-layout">
      <div class="hero-main">
        <p class="hero-eyebrow">Free domain availability checker</p>
        <h1>Find a domain name<br class="desktop-break" /> that's right for you.</h1>
        <p class="hero-lead">Have a name in mind? Check whether it's available, then explore practical advice before you register.</p>
        <DomainSearch compact={true} heading="Enter the domain you want to check" />
        <p class="hero-disclaimer">Free to check. No account needed. Final availability and pricing are confirmed by the registrar.</p>
      </div>
      <aside class="hero-side" aria-labelledby="quick-advice-title">
        <div class="side-header">Before you register</div>
        <h2 id="quick-advice-title">A good name is just the start.</h2>
        <ul>
          <li><strong>Keep it simple.</strong><span>Choose a name that's easy to spell and say.</span></li>
          <li><strong>Check renewal costs.</strong><span>First-year offers can differ from the regular price.</span></li>
          <li><strong>Avoid brand conflicts.</strong><span>Look for existing businesses using a similar name.</span></li>
        </ul>
        <a href="/blog/how-to-choose-a-domain-name">Read the naming guide <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>
  <section class="container-pad home-guides" id="learn">
    <div class="section-heading">
      <div><p class="section-kicker">Learn the essentials</p><h2>Helpful guides, without the jargon.</h2></div>
      <a href="/blog" class="body-link">View all guides <span aria-hidden="true">→</span></a>
    </div>
    <div class="guide-grid">
      {guides.map((guide) => <a class="guide-card" href={guide.href}>
        <h3>{guide.title}<span aria-hidden="true">↗</span></h3><p>{guide.summary}</p><span class="guide-action">Read guide →</span>
      </a>)}
    </div>
  </section>
  <section class="research-section" id="tools">
    <div class="container-pad">
      <div class="section-heading">
        <div><p class="section-kicker">Domain research</p><h2>Go beyond an availability check.</h2><p class="section-summary">Use the right resource to review a domain's history, compare past sales or explore other names.</p></div>
        <a href="/tools" class="body-link">All research tools <span aria-hidden="true">→</span></a>
      </div>
      <div class="research-grid">
        <a href="/tools#availability"><span class="research-category">Find names</span><h3>Availability & discovery</h3><p>Explore possible names and check which ones may be available.</p><span class="research-arrow" aria-hidden="true">↗</span></a>
        <a href="/tools#history"><span class="research-category">Check background</span><h3>Domain history & DNS</h3><p>Investigate previous uses and technical records for a name.</p><span class="research-arrow" aria-hidden="true">↗</span></a>
        <a href="/tools#value"><span class="research-category">Compare evidence</span><h3>Sales & search research</h3><p>Look at comparable transactions and SEO-related signals.</p><span class="research-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="container-pad bottom-cta">
    <div><h2>New to domain names?</h2><p>Start with the basics: what a domain is, what registration means and what to look out for.</p></div>
    <a href="/blog/what-is-a-domain-name" class="button-accent">Learn how domains work <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
<style>
  .home-hero { background: #172334; border-bottom: 1px solid var(--line); }
  .hero-layout { display: grid; grid-template-columns: minmax(0,1.9fr) minmax(240px,.82fr); gap: clamp(2.5rem,5vw,5.25rem); padding-block: clamp(4.5rem,7.5vw,7rem) clamp(4rem,7vw,6rem); align-items: start; }
  .hero-main { min-width: 0; }
  .hero-eyebrow { color: #c2d3e9; font-size: .85rem; font-weight: 670; margin-bottom: 1.35rem; }
  .hero-main h1 { max-width: 820px; font-size: clamp(2.9rem,5.15vw,4.95rem); line-height: 1.13; font-weight: 760; letter-spacing: -.056em; }
  .hero-lead { max-width: 640px; font-size: clamp(1.05rem,1.7vw,1.22rem); line-height: 1.7; color: #c6d2e0; margin: 1.5rem 0 2.25rem; }
  .hero-main .domain-lookup { max-width: 100%; }
  .hero-disclaimer { margin-top: 1rem; font-size: .8rem; line-height: 1.6; color: #b6c5d5; }
  .hero-side { padding: 1.3rem 0 0 1.7rem; border-left: 1px solid #48566a; margin-top: 1.1rem; }
  .side-header { color: #b9cfe8; font-size: .81rem; font-weight: 700; margin-bottom: 1rem; }
  .hero-side h2 { font-weight: 700; letter-spacing: -.025em; line-height: 1.35; font-size: 1.35rem; max-width: 250px; margin-bottom: 2.1rem; }
  .hero-side ul { list-style: none; padding: 0; margin: 0 0 1.8rem; }
  .hero-side li { border-top: 1px solid #48566a; padding: 1.1rem 0; }
  .hero-side li strong { display: block; margin-bottom: .25rem; font-size: .88rem; }
  .hero-side li span { display: block; font-size: .84rem; line-height: 1.6; color: #bbc8d7; }
  .hero-side a { font-size: .87rem; font-weight: 650; text-decoration: none; color: #bdd8fa; }
  .hero-side a:hover { color: white; }
  .home-guides { padding-block: clamp(4rem,7vw,6rem); }
  .guide-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
  .guide-card { border: 1px solid var(--line); background: var(--surface); padding: 1.9rem; border-radius: 7px; min-height: 250px; text-decoration: none; display: flex; flex-direction: column; transition: border-color .15s ease,background .15s ease; }
  .guide-card:hover { border-color: #839fc2; background: #223247; }
  .guide-card h3 { font-size: 1.18rem; line-height: 1.4; font-weight: 690; letter-spacing: -.025em; display: flex; justify-content: space-between; gap: .75rem; }
  .guide-card h3 span { color: var(--accent); font-weight: 400; }
  .guide-card p { font-size: .91rem; color: var(--muted); margin: 1rem 0 1.7rem; line-height: 1.65; }
  .guide-action { margin-top: auto; font-size: .84rem; font-weight: 650; color: var(--accent); }
  .research-section { background: #e8edf3; color: #1c2939; padding-block: clamp(4rem,7vw,6rem); }
  .research-section .section-kicker { color: #456b9e; }
  .research-section .section-summary { font-size: .95rem; color: #4b5c70; margin-top: 1rem; max-width: 550px; }
  .research-section .body-link { color: #234f87; }
  .research-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
  .research-grid a { color: #1d3047; position: relative; border: 1px solid #c6d0dc; border-radius: 7px; background: #f6f8fa; text-decoration: none; padding: 1.8rem; min-height: 235px; }
  .research-grid a:hover { border-color: #648bb8; }
  .research-category { display: block; color: #49698f; font-size: .79rem; font-weight: 700; margin-bottom: 1.6rem; }
  .research-grid h3 { font-size: 1.16rem; font-weight: 720; letter-spacing: -.025em; padding-right: 1rem; }
  .research-grid p { font-size: .88rem; line-height: 1.6; color: #506176; margin-top: .8rem; padding-right: .5rem; }
  .research-arrow { position: absolute; right: 1.5rem; top: 1.6rem; color: #355f91; }
  .bottom-cta { margin-top: 5rem; display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 2.5rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .bottom-cta h2 { font-weight: 720; font-size: clamp(1.5rem,2.5vw,2rem); letter-spacing: -.035em; }
  .bottom-cta p { margin-top: .6rem; color: var(--muted); max-width: 570px; font-size: .91rem; }
  @media(max-width:930px) { .hero-layout { grid-template-columns: 1fr; gap: 2.5rem; } .hero-side { margin: 0; padding: 1.6rem 0 0; border-left: 0; border-top: 1px solid var(--line); } .hero-side h2 { max-width: none; margin-bottom: 1rem; } .hero-side ul { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; } }
  @media(max-width:740px) { .guide-grid,.research-grid { grid-template-columns: 1fr; } .guide-card,.research-grid a { min-height: unset; } .hero-side ul { grid-template-columns: 1fr; gap: 0; } .bottom-cta { align-items: flex-start; flex-direction: column; } }
  @media(max-width:500px) { .hero-main h1 { font-size: clamp(2.55rem,10.5vw,3.15rem); } .desktop-break { display: none; } .hero-layout { padding-block: 3.5rem; } }
</style>
