---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainSearch from '../components/DomainSearch.astro';
const title = 'Free Domain Availability Checker & Domain Name Guides | Domain Discoverer';
const description = 'Search domain name availability for free, discover practical domain research tools, and learn how to choose a domain name, compare extensions, and register with confidence.';
const guides = [
  { no:'01', title:'What is a domain name?', summary:'Learn what a domain actually does and how it connects people to a website.', href:'/blog/what-is-a-domain-name' },
  { no:'02', title:'How to choose a domain name', summary:'A practical checklist for finding a clear, memorable name for your business or idea.', href:'/blog/how-to-choose-a-domain-name' },
  { no:'03', title:'Domain name vs web hosting', summary:'Understand the two services before you pay for either one.', href:'/blog/domain-name-vs-web-hosting' }
];
---
<BaseLayout {title} {description}>
  <section class="home-hero">
    <div class="container-pad hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent domain research & education <span aria-hidden="true">/ 001</span></p>
        <h1 class="display">Good things start with <em>the right name.</em></h1>
        <p class="hero-lead">Find out whether a domain is available. Understand how names work. Make your next move with confidence, not guesswork.</p>
        <div class="hero-links"><a href="#check" class="body-link">Try a domain search <span aria-hidden="true">↗</span></a><a href="/blog" class="body-link subdued">Explore the guides <span aria-hidden="true">↗</span></a></div>
      </div>
      <aside class="hero-aside" aria-label="How Domain Discoverer works">
        <span class="aside-number">D / 01</span>
        <span class="aside-rule"></span>
        <p><span>DISCOVER</span> a name worth remembering.</p>
        <p><span>UNDERSTAND</span> how the domain works.</p>
        <p><span>DECIDE</span> what to register next.</p>
        <span class="aside-caption">A starting point for builders, businesses, and curious people.</span>
      </aside>
    </div>
  </section>
  <section id="check" class="container-pad search-section">
    <div class="section-heading" data-reveal>
      <div><p class="section-kicker">01 / Find your name</p><h2>Domain availability, <em>without the noise.</em></h2></div>
      <p class="section-note">A focused, one-at-a-time search using our existing registrar lookup connection.</p>
    </div>
    <DomainSearch compact={true} heading="Enter a domain to check" />
    <p class="search-disclaimer">Availability is not a reservation. Always confirm registration, pricing and eligibility with the registrar.</p>
  </section>
  <section class="feature-band">
    <div class="container-pad band-grid">
      <div data-reveal><span>01</span><strong>Search</strong><p>Check a specific name before investing more time in it.</p></div>
      <div data-reveal><span>02</span><strong>Learn</strong><p>Understand extensions, registration, privacy and renewals.</p></div>
      <div data-reveal><span>03</span><strong>Choose</strong><p>Compare your options using clear, practical criteria.</p></div>
    </div>
  </section>
  <section class="container-pad content-section" id="learn">
    <div class="section-heading" data-reveal>
      <div><p class="section-kicker">02 / The learning library</p><h2>Know what you are <em>buying.</em></h2></div>
      <a class="body-link" href="/blog">All domain guides <span aria-hidden="true">↗</span></a>
    </div>
    <div class="rail-grid">
      {guides.map((guide) => <a href={guide.href} class="rail-item" data-reveal><span class="rail-index">{guide.no} / THE BASICS</span><h3>{guide.title} <span aria-hidden="true">↗</span></h3><p>{guide.summary}</p></a>)}
    </div>
  </section>
  <section class="container-pad content-section" id="tools">
    <div class="section-heading" data-reveal>
      <div><p class="section-kicker">03 / Useful research</p><h2>The right tool for <em>the question.</em></h2></div>
      <a class="body-link" href="/tools">Browse research tools <span aria-hidden="true">↗</span></a>
    </div>
    <div class="tools-list">
      <a href="/tools#availability" data-reveal><span>01 / Name checks</span><strong>Availability & ideas</strong><span class="tools-arrow" aria-hidden="true">↗</span></a>
      <a href="/tools#history" data-reveal><span>02 / Due diligence</span><strong>History & ownership</strong><span class="tools-arrow" aria-hidden="true">↗</span></a>
      <a href="/tools#value" data-reveal><span>03 / Research</span><strong>Comparable sales & SEO</strong><span class="tools-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="container-pad question-section">
    <div class="question-panel" data-reveal><p class="section-kicker">Still figuring it out?</p><h2 class="display">You don't need to be a domain expert to <em>begin well.</em></h2><p>Start with the fundamentals, ask better questions and keep control of the decisions that matter.</p><a href="/blog" class="button-accent">Start learning <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
<style>
  .home-hero { border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: 1.5fr .55fr; gap: 5vw; padding-block: clamp(5rem, 11vw, 10rem); align-items: end; }
  .hero-copy h1 { font-size: clamp(4.1rem, 9vw, 9rem); max-width: 1000px; margin: 1.5rem 0 2.5rem; }
  .hero-lead { font-size: clamp(1.08rem, 1.7vw, 1.35rem); max-width: 580px; color: var(--muted); line-height: 1.6; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2.3rem; }
  .hero-links .subdued { color: var(--text); border-color: var(--line); }
  .hero-aside { display: flex; flex-direction: column; border-left: 1px solid var(--line); padding: 1.3rem 0 0 2rem; gap: 1.1rem; }
  .aside-number { font: 2.6rem var(--serif); color: var(--accent); }
  .aside-rule { display: block; width: 100%; height: 1px; background: var(--line); margin-bottom: 1rem; }
  .hero-aside p { font-size: 1rem; line-height: 1.45; }
  .hero-aside p span { display: block; letter-spacing: .18em; color: var(--accent); font-size: .65rem; font-weight: 750; margin-bottom: .4rem; }
  .aside-caption { color: var(--muted); font-size: .75rem; margin-top: 1.6rem; }
  .search-section { padding-block: 7rem; }
  .search-section h2, .content-section h2 { max-width: 760px; }
  .search-section h2 em, .content-section h2 em { color: var(--accent); font-weight: 400; }
  .section-note { color: var(--muted); max-width: 240px; font-size: .92rem; }
  .search-disclaimer { color: var(--muted); font-size: .78rem; margin-top: 1.1rem; }
  .feature-band { background: var(--cream); color: var(--paper-ink); }
  .band-grid { display: grid; grid-template-columns: repeat(3,1fr); }
  .band-grid > div { padding: 3rem 2rem; border-right: 1px solid #c2c8b9; }
  .band-grid > div:first-child { padding-left: 0; }
  .band-grid > div:last-child { border-right: 0; }
  .band-grid span { font-size: .78rem; margin-right: 1rem; color: #586c4e; }
  .band-grid strong { font: 2.25rem var(--serif); }
  .band-grid p { margin-top: 1rem; max-width: 245px; font-size: .9rem; }
  .content-section { padding-top: 7rem; }
  .tools-list { border-top: 1px solid var(--line); }
  .tools-list a { display: grid; grid-template-columns: 1fr 1.5fr auto; align-items: center; gap: 1.4rem; text-decoration: none; border-bottom: 1px solid var(--line); padding: 2rem .5rem; transition: background .25s ease, padding .25s ease; }
  .tools-list a:hover { background: var(--surface); padding-left: 1rem; }
  .tools-list span { font-size: .85rem; color: var(--muted); }
  .tools-list strong { font-family: var(--serif); font-weight: 400; font-size: clamp(1.4rem,3vw,2.6rem); }
  .tools-list .tools-arrow { color: var(--accent); font-size: 1.5rem; }
  .question-section { padding-top: 7rem; }
  .question-panel { background: var(--surface-2); border: 1px solid var(--line); padding: clamp(2rem, 7vw, 6rem); }
  .question-panel h2 { font-size: clamp(3rem, 5.5vw, 6rem); max-width: 860px; margin: 1.5rem 0; }
  .question-panel p:not(.section-kicker) { max-width: 650px; color: var(--muted); font-size: 1.1rem; margin: 1.5rem 0 2rem; }
  @media(max-width:850px) { .hero-grid { grid-template-columns: 1fr; gap: 3rem; } .hero-aside { display: none; } }
  @media(max-width:650px) { .hero-copy h1 { font-size: clamp(3.55rem, 15vw, 5rem); } .search-section, .content-section { padding-top: 4.5rem; padding-bottom: 3rem; } .band-grid { grid-template-columns: 1fr; } .band-grid > div { border-right: 0; border-bottom: 1px solid #c2c8b9; padding: 2rem 0; } .tools-list a { grid-template-columns: 1fr auto; } .tools-list strong { grid-column: 1; grid-row: 2; } .tools-list .tools-arrow { grid-column: 2; grid-row: 1 / 3; } }
</style>
