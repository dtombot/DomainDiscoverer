---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainSearch from '../components/DomainSearch.astro';
import HeroGeometry from '../components/HeroGeometry.astro';
const title = 'Free Domain Availability Checker & Domain Name Guides | Domain Discoverer';
const description = 'Check domain name availability without signing up, explore popular extensions, and read practical guides to choosing and registering domains.';
const guides = [
  { category:'Getting started', title:'What is a domain name?', description:'A plain-English explanation of domain names, how they work and what registration means.', href:'/blog/what-is-a-domain-name' },
  { category:'Choosing a name', title:'How to choose a domain name', description:'Build a shortlist of clear, memorable names and avoid common registration mistakes.', href:'/blog/how-to-choose-a-domain-name' },
  { category:'Domain extensions', title:'Understanding .com and other extensions', description:'How to decide between different extensions, and what to check before buying.', href:'/blog/domain-extensions-guide' }
];
const tools = [
  { index:'Availability', title:'Find names and alternatives', description:'Research domain availability and see what other options you could consider.', href:'/tools#availability' },
  { index:'History', title:'Investigate a domain\'s past', description:'Explore DNS records, usage history and other technical signals.', href:'/tools#history' },
  { index:'Valuation', title:'Compare sales and search data', description:'Look at recorded domain sales and interpret SEO-related metrics with care.', href:'/tools#value' }
];
---
<BaseLayout {title} {description}>
  <section class="home-hero" id="check">
    <HeroGeometry />
    <div class="container-pad hero-content">
      <div class="hero-overline"><span>DOMAIN AVAILABILITY</span><span>Free to check · No account needed</span></div>
      <div class="hero-heading-row">
        <div><h1>Find a name.<br /><span class="hero-highlight">Make it yours.</span></h1></div>
        <p>Explore domain availability, compare extensions and learn what matters before you register.</p>
      </div>
      <DomainSearch compact={true} heading="Search for a domain name" />
      <div class="hero-after">
        <span>One name at a time. Availability is confirmed by the registrar at checkout.</span>
        <a href="/blog/how-to-check-domain-availability-smart-way">How domain checking works <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="home-learn" id="learn">
    <div class="container-pad learn-layout">
      <div class="learn-intro">
        <p class="section-kicker">The essentials</p>
        <h2>Know what you’re registering.</h2>
        <p>A domain name is a long-term decision. These short, practical guides explain the essentials so you can choose with confidence.</p>
        <a class="dark-link" href="/blog">Explore the full learning library <span aria-hidden="true">↗</span></a>
      </div>
      <div class="learn-list">
        {guides.map(guide => <a href={guide.href} class="learn-item">
          <span class="learn-category">{guide.category}</span>
          <h3>{guide.title}<span aria-hidden="true">↗</span></h3>
          <p>{guide.description}</p>
        </a>)}
      </div>
    </div>
  </section>

  <section class="home-tools" id="tools">
    <div class="container-pad">
      <div class="section-heading">
        <div><p class="section-kicker">Research desk</p><h2>Make the next decision easier.</h2><p class="tools-intro">Availability is only one part of choosing a domain. Use these research paths when you need a closer look.</p></div>
        <a class="body-link" href="/tools">All research tools <span aria-hidden="true">↗</span></a>
      </div>
      <div class="tool-index">
        {tools.map(tool => <a class="tool-index-item" href={tool.href}>
          <span class="tool-type">{tool.index}</span>
          <span class="tool-copy"><strong>{tool.title}</strong><span>{tool.description}</span></span>
          <span class="tool-index-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="container-pad home-last">
    <div><span class="section-kicker">New to domain names?</span><h2>Start with the basics.</h2><p>Understand the difference between a domain name and web hosting, then work through the registration checklist.</p></div>
    <div class="last-links"><a class="body-link" href="/blog/domain-name-vs-web-hosting">Domain names vs web hosting <span aria-hidden="true">↗</span></a><a class="body-link" href="/blog/how-to-choose-a-domain-name">Choosing your domain <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
<style>
  .home-hero { position:relative; isolation:isolate; overflow:hidden; padding-block:clamp(4rem,6vw,6rem) clamp(3.8rem,5vw,5.2rem); background:#15213c; border-bottom:1px solid #465d85; }
  .home-hero::before { content:''; position:absolute; z-index:0; inset:auto -15% -55% 26%; width:86%; height:83%; background:#111b35; transform:rotate(-17deg); clip-path:polygon(0 0,100% 0,100% 66%,0 100%); }
  .hero-content { position:relative; z-index:2; }
  .hero-highlight { color:#a8eee4; }

  .hero-overline { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.25rem; color: var(--accent); font-size: .73rem; font-weight: 650; letter-spacing: .14em; }
  .hero-overline span:last-child { color: #b8c9e0; font-weight: 440; letter-spacing: .015em; font-size: .8rem; }
  .hero-heading-row { display: grid; grid-template-columns: minmax(0,1.55fr) minmax(245px,.72fr); align-items: end; gap: 3rem; margin-bottom: 3.15rem; }
  .hero-heading-row h1 { max-width: 790px; font-size: clamp(3.65rem,6.9vw,6.65rem); line-height: 1.045; font-weight: 560; letter-spacing: -.067em; color: #f8fbff; }
  .hero-heading-row p { max-width:335px; position:relative; color:#E4EEFA; font-size:1.03rem; line-height:1.72; padding:1.05rem 0 1.05rem 1.3rem; border-left:2px solid #74C6C6; background:#15213c; }
  .home-hero :global(.domain-lookup) { position:relative; max-width:1050px; margin-top:.3rem; }
  .hero-after { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; padding-top:1.25rem; color:#C5D6E9; font-size:.78rem; }
  .hero-after a { flex: none; text-decoration: none; color: #a8eee4; font-size: .8rem; }
  .hero-after a:hover { color: #fff; }
  .home-learn { position:relative; background: var(--cream); color: var(--paper-ink); padding-block: clamp(4.5rem,8vw,8rem); }
  .learn-layout { display: grid; grid-template-columns: minmax(280px,.83fr) minmax(0,1.17fr); gap: clamp(3rem,8vw,9rem); align-items: start; }
  .home-learn .section-kicker { color: #376e83; }
  .learn-intro { position: sticky; top: 7.5rem; }
  .learn-intro h2 { max-width: 460px; font-size: clamp(2.55rem,4.6vw,4.5rem); line-height: 1.12; letter-spacing: -.06em; font-weight: 585; margin: 1.2rem 0 1.6rem; }
  .learn-intro > p:not(.section-kicker) { max-width: 390px; color: #607687; font-size: 1.02rem; line-height: 1.8; margin-bottom: 2rem; }
  .dark-link { display: inline-flex; align-items: center; gap: 1.3rem; color: #1b354f; font-size: .89rem; font-weight: 650; text-decoration: none; border-bottom: 1px solid #5b8798; padding-bottom: .45rem; }
  .dark-link:hover { color: #146e7c; }
  .learn-list { border-top: 1px solid var(--paper-line); }
  .learn-item { display: block; text-decoration: none; border-bottom: 1px solid var(--paper-line); padding: 1.65rem 0 1.85rem; transition: padding-left .18s ease; }
  .learn-item:hover { padding-left: .45rem; }
  .learn-category { font-size: .75rem; color: #496f86; font-weight: 650; }
  .learn-item h3 { display: flex; justify-content: space-between; gap: 1rem; margin-top: .65rem; color: #20354e; font-size: clamp(1.4rem,2.2vw,1.85rem); font-weight: 580; letter-spacing: -.04em; line-height: 1.3; }
  .learn-item h3 span { font-size: 1.15rem; color: #518fa4; }
  .learn-item p { max-width: 490px; margin-top: .65rem; font-size: .91rem; color: #607789; line-height: 1.7; }
  .home-tools { padding-block: clamp(4.5rem,7.5vw,7.5rem); }
  .home-tools .section-heading { margin-bottom: 3rem; }
  .home-tools h2 { max-width: 720px; font-size: clamp(2.3rem,4vw,3.7rem); font-weight: 570; }
  .tools-intro { max-width: 565px; margin-top: 1rem; color: var(--muted); font-size: .95rem; }
  .tool-index { border-top: 1px solid #425678; }
  .tool-index-item { display: grid; grid-template-columns: minmax(140px,.34fr) minmax(0,1fr) 24px; gap: 1.75rem; padding: 1.8rem .25rem; align-items: center; border-bottom: 1px solid #425678; text-decoration: none; transition: background .15s ease,padding .15s ease; }
  .tool-index-item:hover { background: #1d2844; padding-left: .85rem; }
  .tool-type { color: var(--accent); font-size: .8rem; }
  .tool-copy { display: flex; flex-direction: column; gap: .3rem; }
  .tool-copy strong { color: #eff6ff; font-size: clamp(1.2rem,2.4vw,1.9rem); font-weight: 550; letter-spacing: -.035em; }
  .tool-copy span { color: #b4c5d8; font-size: .9rem; }
  .tool-index-arrow { justify-self: end; font-size: 1.15rem; color: var(--accent); }
  .home-last { display: flex; justify-content: space-between; align-items: end; gap: 2rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  .home-last h2 { font-size: clamp(1.85rem,3vw,2.6rem); letter-spacing: -.04em; font-weight: 570; margin: .35rem 0 .5rem; }
  .home-last p { max-width: 500px; color: var(--muted); font-size: .91rem; }
  .last-links { display: flex; flex-direction: column; align-items: flex-end; gap: 1rem; }
  @media(max-width:900px) {
    .hero-heading-row { grid-template-columns: 1fr; gap: 1.1rem; }
    .hero-heading-row p { max-width: 680px; padding-bottom: 0; }
    .learn-layout { grid-template-columns: 1fr; gap: 2rem; }
    .learn-intro { position: static; }
  }
  @media(max-width:700px) {
    .hero-heading-row { margin-bottom: 2rem; }
    .hero-heading-row h1 { font-size: clamp(3.05rem,12.3vw,4.5rem); letter-spacing: -.06em; }
    .hero-overline { margin-bottom: 1.55rem; letter-spacing: .09em; }
    .hero-after { flex-direction: column; align-items: flex-start; gap: .65rem; }
    .tool-index-item { grid-template-columns: 1fr 22px; gap: .5rem; padding-block: 1.4rem; }
    .tool-type { grid-column: 1/-1; }
    .tool-copy { grid-column: 1; }
    .tool-index-arrow { grid-column: 2; grid-row: 2; }
    .home-last { flex-direction: column; align-items: flex-start; }
    .last-links { align-items: flex-start; }
  }
</style>
