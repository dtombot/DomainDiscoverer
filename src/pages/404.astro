---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That Domain Discoverer page could not be found." robots="noindex,follow">
  <section class="page-hero"><div class="container-pad">
    <p class="eyebrow">Page not found</p>
    <h1 class="display">We couldn't find that page.</h1>
    <p>The page might have moved, or the link might be incorrect. Try the domain checker or start again from the learning library.</p>
    <div class="mt-8 flex flex-wrap gap-5"><a class="button-accent" href="/">Return home →</a><a class="body-link" href="/blog">Browse guides ↗</a></div>
  </div></section>
</BaseLayout>
