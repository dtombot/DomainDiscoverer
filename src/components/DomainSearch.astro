---
interface Props { compact?: boolean; heading?: string; }
const { compact = false, heading = 'Domain name' } = Astro.props as Props;
const id = compact ? 'hero-domain' : 'page-domain';
const choices = ['.com','.net','.org','.io','.co','.app'];
---
<div class:list={['domain-lookup',{ compact }]}>
  <form class="domain-search" action="/domain-availability-checker" method="get" novalidate>
    <div class="lookup-top">
      <label for={id}>{heading}</label>
      <span class="lookup-free"><span class="lookup-free-dot" aria-hidden="true"></span> Free domain lookup</span>
    </div>
    <div class="input-row">
      <div class="input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 5 5"/></svg>
        <input id={id} name="domain" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="url" placeholder="yourname.com" maxlength="253" required aria-describedby={`${id}-help`} />
      </div>
      <button class="lookup-submit" type="submit"><span class="submit-label">Check availability</span><span class="submit-arrow" aria-hidden="true">↗</span></button>
    </div>
    <div class="lookup-footer">
      <div class="extension-row" role="group" aria-label="Select a domain extension">
        <span class="extension-caption">Popular extensions</span>
        {choices.map(ext => <button type="button" class="extension-choice" data-extension={ext} aria-pressed="false">{ext}</button>)}
      </div>
      <p class="search-help" id={`${id}-help`}>Enter a name or paste a domain URL. Checks run only when you submit.</p>
    </div>
    <div class="lookup-result" role="status" aria-live="polite" aria-atomic="true" hidden>
      <div class="result-top">
        <span class="result-icon" aria-hidden="true"></span>
        <div class="result-main">
          <strong class="result-label"></strong>
          <p class="result-detail"></p>
        </div>
      </div>
      <div class="result-actions">
        <a class="result-link" href="#" target="_blank" rel="noopener noreferrer" hidden>Check with registrar <span aria-hidden="true">↗</span></a>
        <button class="copy-domain" type="button" hidden>Copy domain</button>
        <a class="result-guide" href="/blog/how-to-choose-a-domain-name">Domain naming tips <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </form>
</div>
<style>
  .domain-lookup { width: 100%; max-width: 880px; background: #f0f7fb; border: 1px solid #d5e5ef; border-radius: 7px; padding: clamp(1.3rem,3.2vw,2.15rem); color: #203149; }
  .domain-lookup.compact { max-width: none; }
  .lookup-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .8rem; }
  .lookup-top label { color: #2b3b50; font-size: .9rem; font-weight: 670; }
  .lookup-free { color: #5c7185; font-size: .75rem; display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap; }
  .lookup-free-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #44b5aa; }
  .input-row { display: flex; gap: .6rem; }
  .input-wrap { display: flex; align-items: center; gap: .75rem; flex: 1 1 auto; min-width: 0; background: #fff; border: 1px solid #c1d3e1; border-radius: 4px; padding-inline: 1.1rem; transition: border-color .15s ease; }
  .input-wrap:focus-within { border-color: #5686a8; outline: 2px solid rgba(63,66,69,.18); outline-offset: 1px; }
  .input-wrap svg { width: 21px; height: 21px; flex: 0 0 auto; color: #7692a7; }
  .input-wrap input { min-width: 0; width: 100%; padding: 1.22rem 0; border: 0; outline: 0; background: transparent; color: #203149; font-size: clamp(1rem,2vw,1.18rem); line-height: 1.3; letter-spacing: -.015em; }
  .input-wrap input:focus-visible { outline: 0; }
  .input-wrap input::placeholder { color: #7892a9; opacity: 1; }
  .lookup-submit { display: inline-flex; justify-content: center; align-items: center; gap: 1.2rem; flex: none; padding: .85rem 1.25rem; color: #102a39; background: #9cece0; border: 1px solid #9cece0; border-radius: 4px; font-size: .9rem; font-weight: 640; transition: background .16s ease; }
  .lookup-submit:hover { background: #b9f3ea; }
  .lookup-submit:disabled { cursor: progress; opacity: .7; }
  .submit-arrow { font-size: 1.08rem; font-weight: 400; }
  .lookup-footer { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.05rem; }
  .extension-row { display: flex; align-items: center; gap: .32rem; flex-wrap: wrap; }
  .extension-caption { color: #647b8e; font-size: .76rem; margin-right: .45rem; }
  .extension-choice { color: #49677d; font-size: .78rem; line-height: 1.25; padding: .33rem .52rem; background: transparent; border: 1px solid #c4d7e4; border-radius: 4px; transition: background .12s ease,border-color .12s ease; }
  .extension-choice:hover, .extension-choice[aria-pressed="true"] { color: #9cece0; border-color: #3b8f9b; background: #d5f2f1; }
  .search-help { color: #647b8e; font-size: .74rem; line-height: 1.5; }
  .lookup-result { padding: 1.25rem; margin-top: 1.35rem; background: #fbfeff; border: 1px solid #c8dbe9; border-radius: 4px; }
  .result-top { display: flex; align-items: flex-start; gap: .85rem; }
  .result-icon { margin-top: .45rem; width: 9px; height: 9px; flex: 0 0 auto; border-radius: 50%; background: #708eab; }
  .lookup-result[data-state="available"] .result-icon { background: #18846d; }
  .lookup-result[data-state="taken"] .result-icon { background: #bd763c; }
  .lookup-result[data-state="error"] .result-icon { background: #ba4d5b; }
  .result-label { display: block; color: #203149; font-size: 1.025rem; font-weight: 680; overflow-wrap: anywhere; }
  .result-detail { margin-top: .4rem; color: #567085; font-size: .88rem; line-height: 1.6; }
  .result-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem 1.4rem; margin: 1.15rem 0 0 1.75rem; }
  .result-link { display: inline-flex; align-items: center; gap: .8rem; padding: .59rem .83rem; border: 1px solid #286878; border-radius: 4px; color: white; background: #1f5161; font-size: .82rem; font-weight: 630; text-decoration: none; }
  .result-link:hover { background: #286a77; }
  .copy-domain, .result-guide { padding: .15rem 0; border: 0; color: #456277; font-size: .82rem; font-weight: 620; background: none; text-decoration: underline; text-underline-offset: .25rem; }
  .copy-domain:hover, .result-guide:hover { color: #123149; }
  .domain-search :focus-visible { outline-color: #4daaab; }
  @media(max-width:730px) { .lookup-footer { align-items: flex-start; flex-direction: column; } }
  @media(max-width:580px) {
    .domain-lookup { padding: 1.05rem; }
    .input-row { flex-direction: column; gap: .65rem; }
    .lookup-submit { min-height: 50px; width: 100%; justify-content: space-between; }
    .input-wrap input { padding-block: 1rem; }
    .lookup-free { font-size: .7rem; }
    .extension-caption { flex-basis: 100%; }
    .result-actions { margin-left: 0; }
  }
</style>
<script>
  import { domainPattern, cleanDomain, normalizeDomain, withExtension } from '../utils/domain.mjs';
  document.querySelectorAll('.domain-search').forEach((form) => {
    const input = form.querySelector('input[name="domain"]');
    const button = form.querySelector('.lookup-submit');
    const buttonLabel = form.querySelector('.submit-label');
    const result = form.querySelector('.lookup-result');
    const label = form.querySelector('.result-label');
    const detail = form.querySelector('.result-detail');
    const link = form.querySelector('.result-link');
    const copyButton = form.querySelector('.copy-domain');
    const resultActions = form.querySelector('.result-actions');
    const extensions = [...form.querySelectorAll('[data-extension]')];
    const params = new URLSearchParams(location.search);
    if (params.has('domain') && !input.value) input.value = (params.get('domain') || '').slice(0, 253);
    let requestNumber = 0;
    let controller = null;
    let checkedDomain = '';
    const updateExtensions = () => {
      const name = cleanDomain(input.value);
      extensions.forEach(el => el.setAttribute('aria-pressed', String(Boolean(name && name.endsWith(el.dataset.extension)))));
    };
    const resetResult = () => {
      ++requestNumber;
      controller?.abort();
      controller = null;
      checkedDomain = '';
      result.hidden = true;
      button.disabled = false;
      buttonLabel.textContent = 'Check availability';
    };
    input.addEventListener('input', () => { resetResult(); updateExtensions(); });
    extensions.forEach(chip => chip.addEventListener('click', () => {
      if (!cleanDomain(input.value)) {
        input.placeholder = 'yourname' + chip.dataset.extension;
        input.focus();
        return;
      }
      input.value = withExtension(input.value, chip.dataset.extension);
      resetResult();
      updateExtensions();
      input.focus();
    }));
    updateExtensions();
    copyButton.addEventListener('click', async () => {
      if (!checkedDomain || !navigator.clipboard?.writeText) return;
      try {
        await navigator.clipboard.writeText(checkedDomain);
        copyButton.textContent = 'Copied';
      } catch (_) { copyButton.textContent = 'Copy unavailable'; }
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const domain = normalizeDomain(input.value);
      if (!domainPattern.test(domain)) {
        resetResult();
        result.hidden = false;
        result.dataset.state = 'error';
        label.textContent = 'Check the domain name';
        detail.textContent = 'Please enter a valid name like example.com. Spaces, special characters and incomplete extensions are not supported.';
        link.hidden = true;
        copyButton.hidden = true;
        resultActions.hidden = false;
        input.focus();
        return;
      }
      resetResult();
      input.value = domain;
      updateExtensions();
      const thisRequest = ++requestNumber;
      const lookupController = new AbortController();
      controller = lookupController;
      const timeout = setTimeout(() => lookupController.abort(), 10000);
      result.hidden = false;
      result.dataset.state = 'loading';
      label.textContent = 'Checking ' + domain;
      detail.textContent = 'Requesting a live registrar lookup…';
      link.hidden = true;
      copyButton.hidden = true;
      resultActions.hidden = true;
      button.disabled = true;
      buttonLabel.textContent = 'Checking…';
      try {
        const response = await fetch('/.netlify/functions/check-domain?domain=' + encodeURIComponent(domain), { method:'GET', signal:lookupController.signal,cache:'no-store' });
        const data = await response.json();
        if (!response.ok || !['available','taken'].includes(data.status)) throw new Error('Service unavailable');
        if (thisRequest !== requestNumber) return;
        checkedDomain = domain;
        resultActions.hidden = false;
        copyButton.hidden = false;
        copyButton.textContent = 'Copy domain';
        if (data.status === 'available') {
          result.dataset.state = 'available';
          label.textContent = domain + ' may be available';
          detail.textContent = 'The lookup reports this domain as available. Registration and final pricing must be confirmed at checkout.';
          link.href = 'https://www.namecheap.com/domains/registration/results/?domain=' + encodeURIComponent(domain);
          link.hidden = false;
        } else {
          result.dataset.state = 'taken';
          label.textContent = domain + ' is already registered';
          detail.textContent = 'Try a different extension above, or adjust the name and check again. Each check is made only when you submit.';
          link.hidden = true;
        }
      } catch (error) {
        if (thisRequest !== requestNumber) return;
        result.dataset.state = 'error';
        label.textContent = 'Unable to check this domain';
        detail.textContent = 'The lookup service could not complete the request. Please try again or verify with a registrar.';
        link.hidden = true;
        copyButton.hidden = true;
        resultActions.hidden = false;
      } finally {
        clearTimeout(timeout);
        if (thisRequest === requestNumber) {
          controller = null;
          button.disabled = false;
          buttonLabel.textContent = 'Check availability';
        }
      }
    });
  });
</script>
