---
interface Props { compact?: boolean; heading?: string; }
const { compact = false, heading = 'Enter a domain name' } = Astro.props as Props;
---
<div class:list={['domain-lookup', { compact }]}>
  <form class="domain-search" action="/domain-availability-checker" method="get" novalidate>
    <label for={compact ? 'quick-domain' : 'full-domain'}>{heading}</label>
    <div class="input-row">
      <input id={compact ? 'quick-domain' : 'full-domain'} name="domain" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="url" placeholder="example.com" maxlength="253" required aria-describedby={compact ? 'quick-help' : 'full-help'} />
      <button type="submit">Check availability <span aria-hidden="true">→</span></button>
    </div>
    <p class="search-help" id={compact ? 'quick-help' : 'full-help'}>Enter a full domain or just a name to check its .com version.</p>
    <div class="lookup-result" role="status" aria-live="polite" aria-atomic="true" hidden>
      <strong class="result-label"></strong>
      <p class="result-detail"></p>
      <a class="result-link" href="#" target="_blank" rel="noopener noreferrer" hidden>Review registration options ↗</a>
    </div>
  </form>
</div>
<style>
  .domain-lookup { max-width: 790px; padding: clamp(1.15rem,2.5vw,1.65rem); border: 1px solid #d3dce6; border-radius: 9px; background: #e9eef4; color: #1b293a; }
  .domain-search label { display: block; margin: 0 0 .75rem; color: #27384c; font-size: .88rem; font-weight: 700; letter-spacing: 0; }
  .input-row { display: flex; gap: .6rem; }
  .input-row input { flex: 1 1 auto; min-width: 0; width: 100%; border: 1px solid #aebccb; border-radius: 6px; background: #fff; color: #172437; padding: 1rem 1.05rem; font-size: 1.08rem; }
  .input-row input::placeholder { color: #65768a; opacity: 1; }
  .input-row button { flex: none; border: 1px solid #355f97; border-radius: 6px; background: #355f97; color: white; padding: .95rem 1.2rem; font-size: .94rem; font-weight: 710; transition: background .15s ease; }
  .input-row button:hover { background: #234d87; }
  .input-row button:disabled { opacity: .66; cursor: progress; }
  .input-row button span { margin-left: .3rem; }
  .domain-search :focus-visible { outline: 2px solid #315d9b; outline-offset: 2px; }
  .search-help { font-size: .8rem; line-height: 1.55; color: #526479; margin-top: .7rem; }
  .lookup-result { margin-top: 1.1rem; border: 1px solid #b5c3d2; border-radius: 6px; background: #fff; padding: 1rem; }
  .lookup-result[data-state="available"] { border-left: 4px solid #2f775e; }
  .lookup-result[data-state="taken"],.lookup-result[data-state="error"] { border-left: 4px solid #aa6843; }
  .lookup-result[data-state="loading"] { border-left: 4px solid #527cac; }
  .result-label { font-size: .96rem; color: #192c3e; }
  .result-detail { margin-top: .3rem; font-size: .88rem; line-height: 1.55; color: #465a70; }
  .result-link { display: inline-block; margin-top: .7rem; color: #214f87; font-size: .87rem; font-weight: 650; }
  @media(max-width:600px) { .input-row { flex-direction: column; } .input-row button { width: 100%; padding-block: 1rem; } }
</style>
<script>
  const domainPattern = /^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])$/i;
  document.querySelectorAll('.domain-search').forEach((form) => {
    const input = form.querySelector('input[name="domain"]');
    const button = form.querySelector('button[type="submit"]');
    const result = form.querySelector('.lookup-result');
    const label = form.querySelector('.result-label');
    const detail = form.querySelector('.result-detail');
    const link = form.querySelector('.result-link');
    const params = new URLSearchParams(location.search);
    if (params.has('domain') && input && !input.value) input.value = (params.get('domain') || '').slice(0, 253);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      let domain = (input?.value || '').trim().toLowerCase().replace(/\.$/, '');
      if (domain && !domain.includes('.')) domain += '.com';
      if (!domainPattern.test(domain)) {
        result.hidden = false;
        result.dataset.state = 'error';
        label.textContent = 'Enter a valid domain name';
        detail.textContent = 'Use letters, numbers and hyphens with an extension such as .com. Do not include https://, spaces or slashes.';
        link.hidden = true;
        input?.focus();
        return;
      }
      input.value = domain;
      result.hidden = false;
      result.dataset.state = 'loading';
      label.textContent = 'Checking ' + domain + '…';
      detail.textContent = 'Contacting the lookup service.';
      link.hidden = true;
      button.disabled = true;
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 10000);
      try {
        const response = await fetch('/.netlify/functions/check-domain?domain=' + encodeURIComponent(domain), { method: 'GET', signal: controller.signal, cache: 'no-store' });
        const data = await response.json();
        if (!response.ok || !['available', 'taken'].includes(data.status)) throw new Error('Lookup unavailable');
        if (data.status === 'available') {
          result.dataset.state = 'available';
          label.textContent = domain + ' may be available';
          detail.textContent = 'The lookup returned available. Confirm the final price and availability at checkout; results can change.';
          link.href = 'https://www.namecheap.com/domains/registration/results/?domain=' + encodeURIComponent(domain);
          link.hidden = false;
        } else {
          result.dataset.state = 'taken';
          label.textContent = domain + ' is registered';
          detail.textContent = 'Try another name or a different extension. Each check is made only when you submit.';
        }
      } catch (_) {
        result.dataset.state = 'error';
        label.textContent = 'We could not complete the lookup';
        detail.textContent = 'Please try again. You can also confirm the name with your preferred registrar.';
      } finally { clearTimeout(timeout); button.disabled = false; }
    });
  });
</script>
